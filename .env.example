# GitHub token with repo write access for the submit-request function
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub repo in format owner/repo
GITHUB_REPO=yourusername/retrogroove-site

# Plain text password for development (use this OR the hash, not both)
NEXT_PUBLIC_BAND_PASSWORD=RetroGroove$B4nd

# Band phone number for Yape/Plin donations
NEXT_PUBLIC_BAND_PHONE=999 888 777

# Ticketing API base URL — baked into the static export at build time.
# Must point at the deployed API (e.g. https://api.retrogroove.pe/api).
# If unset it defaults to http://localhost:4000/api, which breaks the live site.
NEXT_PUBLIC_API_URL=https://your-api-host/api

# Culqi public key (ticketing checkout)
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_...
